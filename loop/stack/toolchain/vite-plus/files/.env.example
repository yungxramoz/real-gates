# Copy to .env.local for local development and fill in what you need. A fresh clone with only
# these (empty) values still passes `pnpm check` and `pnpm build`.

# The port `pnpm start` listens on. Unset, each part uses its own default.
PORT=

# --- Tooling (not read by the app) ------------------------------------------------------------

# Run the e2e suite against a deployed URL instead of a local `pnpm start`.
E2E_BASE_URL=

# Port of the local `pnpm start` the e2e suite starts. Default 4791.
E2E_PORT=
