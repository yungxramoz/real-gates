# Copy to .env.local for local development and fill in what you need. Real values live in the
# Vercel project's environment variables, never in git. A fresh clone with only these (empty)
# values still passes `pnpm test:unit` and `pnpm build`: env is validated when first used.
#
# Server-only keys are never prefixed NEXT_PUBLIC_: that prefix ships a value to every browser.

# --- App --------------------------------------------------------------------------------------

# development | preview | production. Unset, Vercel's VERCEL_ENV decides.
APP_ENV=development

# The canonical origin of this deployment, used for absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 1 = stub mode (only together with APP_ENV=preview): external services are skipped or pointed at
# local stubs, so e2e runs against a production build with no secrets. See src/lib/stub.ts.
STUB_MODE=

# --- Supabase ---------------------------------------------------------------------------------

# Project URL, e.g. https://<project-ref>.supabase.co, or http://127.0.0.1:54321 for `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (or the legacy anon key). Public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (or the legacy service-role key). Server-only: it bypasses RLS.
SUPABASE_SECRET_KEY=

# --- Email (optional) -------------------------------------------------------------------------

# Base URL of your email provider's HTTP API. In stub mode, a loopback URL of a local stub.
EMAIL_BASE_URL=

# The provider's API key. Server-only.
EMAIL_API_KEY=

# --- Loop and tooling (not read by the app) ---------------------------------------------------

# Direct Postgres connection string of the DEV database. The loop's post-merge step applies new
# migration files with it (loop/loop.config.json -> postMerge[].dbUrlEnv). Never production.
DEV_DB_URL=

# Vercel deployment protection bypass token, sent when the loop polls the dev deployment's
# /api/health (loop/loop.config.json -> deploy.bypassSecretEnv).
VERCEL_BYPASS=

# Run the e2e suite against a deployed URL instead of a local `next start`.
E2E_BASE_URL=

# Port of the local `next start` the e2e suite starts. Default 4791.
E2E_PORT=

# --- Set by Vercel, listed for completeness -----------------------------------------------------

# VERCEL_ENV: production | preview | development.
# VERCEL_GIT_COMMIT_SHA: the commit a deployment was built from; /api/health reports it.
